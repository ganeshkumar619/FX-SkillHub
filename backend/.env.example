# ==========================================
# FX SkillHub Backend Environment Variables
# ==========================================

# Core Django
SECRET_KEY=your-django-secret-key-here
DEBUG=False
ALLOWED_HOSTS=fx-skillhub.onrender.com,localhost,127.0.0.1
DATABASE_URL=postgresql://user:password@hostname/dbname

# Frontend & CORS
FRONTEND_URL=https://fx-skillhub-frontend.onrender.com
PUBLIC_PORTAL_URL=https://fx-skillhub-frontend.onrender.com
CORS_ALLOWED_ORIGINS=https://fx-skillhub-frontend.onrender.com,http://localhost:5173

# Production Email Delivery — Resend HTTPS API (Port 443)
EMAIL_BACKEND=anymail.backends.resend.EmailBackend
ANYMAIL_RESEND_API_KEY=re_your_resend_api_key_here
DEFAULT_FROM_EMAIL=FX SkillHub <onboarding@resend.dev>
EMAIL_TIMEOUT=10

# Optional Legacy SMTP Fallback (For local dev where outbound port 587 is open)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=fxskillhub@gmail.com
# EMAIL_HOST_PASSWORD=your_gmail_app_password
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
GOOGLE_OAUTH_REDIRECT_URI=https://fx-skillhub-frontend.onrender.com/auth/google/callback
